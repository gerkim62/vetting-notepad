{
  "manifest_version": 3,
  "name": "Vetting Notepad",
  "version": "3.1.0",
  "description": "Ultra-compact vetting notepad tool for call agents with customizable items, live character guide, and auto-clear.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "notifications",
    "downloads"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Vetting Notepad",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/break-overlay.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
