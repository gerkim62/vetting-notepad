{
  "manifest_version": 3,
  "name": "Vetting Notepad",
  "version": "1.0.0",
  "description": "Ultra-compact vetting notepad tool for call agents with customizable items, live character guide, and auto-clear.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "panel.html",
    "default_title": "Vetting Notepad",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
